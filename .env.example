# Fill these in later. Local NLP does not need API keys.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional fallback: Groq GPT-OSS 120B, used when the primary AI fails.
GROQ_API_KEY=
TAVILY_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Optional browser fallback for public pages that need JavaScript.
USE_PLAYWRIGHT=false
